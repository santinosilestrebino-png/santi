body {
    background-color: #f5f9ff;
    font-family: Arial, Helvetica, sans-serif;
    margin: 0;
    text-align: center;
}

header,
footer {
    background-color: #1b2a49;
    padding: 20px;
}

header h1 {
    color: #ffffff;
    margin: 0;
}

main {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
}

h2 {
    color: #c0392b;
    margin-top: 40px;
}

main p {
    color: #1b2a49;
    line-height: 1.6;
}

main img {
    max-width: 100%;
    border: 5px solid #e67e22;
}

footer p {
    color: #ffffff;
    margin: 6px 0;
}

.logo {
    width: 70px;
}
